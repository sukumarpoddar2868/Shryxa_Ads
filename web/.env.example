# Copy to .env.local (gitignored). Server-only values — never prefix with NEXT_PUBLIC_.

# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional
SESSION_DAYS=30
TRIAL_DAYS=2

# --- Meta (Phase 2) — Facebook Login for Business ---
# Public base URL of this app (no trailing slash). Redirect URI registered in
# the Meta app must be: ${APP_URL}/api/meta/oauth/callback
APP_URL=http://localhost:3000
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Optional: second config with "System-user access token" (never expires),
# used by agencies for "Connect Business Manager". Falls back to the one above.
META_BUSINESS_CONFIG_ID=
META_API_VERSION=v23.0
# Fernet key (44 chars). MUST match the legacy app's key to read old tokens.
META_TOKEN_ENCRYPTION_KEY=
